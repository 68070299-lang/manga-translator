{
  "name": "manga-translator-extension",
  "version": "1.0.0",
  "description": "Chrome Extension for translating manga images using LLM-powered OCR",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:backend && npm run test:e2e",
    "test:backend": "node scripts/backend-check.js test",
    "lint:backend": "node scripts/backend-check.js lint",
    "compile:backend": "node scripts/backend-check.js compile",
    "verify:repository": "node scripts/repository-check.js",
    "lint": "eslint \"extension/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "lint:all": "npm run lint && npm run lint:backend && npm run compile:backend",
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "launch": "node scripts/launch-extension.js",
    "smoke:backend": "node scripts/backend-check.js smoke",
    "smoke:popup": "node scripts/popup-smoke.js",
    "smoke:real-url": "node scripts/real-url-smoke.js",
    "uat:bookwalker:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bookwalker-real-uat.ps1",
    "verify": "npm run lint:all && npm run test:all && npm run verify:repository && npm run build && npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.263",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sinon": "^17.0.0",
    "sinon-chrome": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/user/manga-translator-extension"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "translation",
    "ocr",
    "gemini",
    "openrouter"
  ],
  "license": "MIT"
}
