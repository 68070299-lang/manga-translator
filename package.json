{
  "name": "manga-translator-extension",
  "version": "1.0.0",
  "description": "Chrome MV3 extension (WXT + TypeScript + Svelte 5) for translating manga images, with a local Python backend",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "validate": "node scripts/validate-extension.ts",
    "verify:repository": "node scripts/repository-check.ts",
    "typecheck": "wxt prepare && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "smoke:popup": "npm run build && node scripts/popup-smoke.ts",
    "smoke:real-url": "npm run build && node scripts/real-url-smoke.ts",
    "smoke:backend": "uv run --project backend --locked python scripts/backend-smoke.py",
    "eval:pipeline": "uv run --project backend --locked python scripts/eval_pipeline.py",
    "uat:bookwalker": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bookwalker-real-uat.ps1",
    "test:backend": "uv run --project backend --locked pytest backend/tests",
    "lint:backend": "uv run --project backend --locked ruff check backend scripts/backend-smoke.py scripts/eval_pipeline.py",
    "typecheck:backend": "uv run --project backend --locked pyright -p backend",
    "test:all": "npm run test && npm run test:backend && npm run test:e2e",
    "verify": "npm run verify:repository && npm run lint && npm run typecheck && npm run lint:backend && npm run typecheck:backend && npm run build && npm run test:coverage && npm run test:backend && npm run zip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/68070299-lang/manga-translator.git"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "translation",
    "ocr",
    "wxt",
    "svelte"
  ],
  "license": "MIT",
  "type": "module"
}
